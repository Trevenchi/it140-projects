START get_item

    SET current_room to player's current room
    SET room_item to item in current_room
    SET inventory to player's inventory

    OUTPUT "Enter the item you want to get"
    INPUT requested_item

    IF requested_item equals room_item
        ADD room_item to inventory
        REMOVE room_item from current_room
        OUTPUT room_item "added to inventory"
    ELSE
        OUTPUT "That item is not in this room"
    END IF

    RETURN to game loop

END get_item

